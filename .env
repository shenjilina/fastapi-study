APP_NAME=FastAPI Study RAG Project
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
API_PREFIX=/api
DATABASE_URL=sqlite:///./rag_project.db
DATABASE_ECHO=false
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_REQUEST_TIMEOUT=60
OLLAMA_MAX_RETRIES=3
OLLAMA_TEMPERATURE=0.7
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_EXTENSIONS=["txt","pdf"]
CHUNK_SIZE=400
CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=1.2
JWT_SECRET_KEY=fastapi-study-dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
CONVERSATION_MEMORY_ROUNDS=4
